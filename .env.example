# Optional local settings. Do not overwrite an existing .env.
APP_NAME=ai-devops-agent
APP_ENV=development
APP_DEBUG=false
# Investigation API: SHA-256 digests of the tokens, never the tokens themselves.
# The routes stay closed while both are unset.
# APP_READ_TOKEN_SHA256=<64 lowercase hex digits>
# APP_WRITE_TOKEN_SHA256=<64 lowercase hex digits>
# APP_STORE_PATH=var/investigations.sqlite3
# Claude agent provider, used only with --provider anthropic. Credentials come
# from ANTHROPIC_API_KEY or an ant profile in your environment, never this file.
# APP_AGENT_MODEL=claude-opus-5-5
# APP_AGENT_EFFORT=high
# APP_AGENT_MAX_SECONDS=300
# APP_AGENT_REQUEST_TIMEOUT_SECONDS=60
